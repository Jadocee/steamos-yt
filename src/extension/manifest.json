{
  "manifest_version": 3,
  "name": "SteamOS YT Companion",
  "short_name": "SteamOS YT",
  "version": "1.1.0",
  "description": "Controller, exit, device identity, SponsorBlock, DeArrow and Return YouTube Dislike for YouTube on TV inside the SteamOS kiosk.",
  "minimum_chrome_version": "111",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.googlevideo.com/*",
    "*://*.ytimg.com/*",
    "*://*.ggpht.com/*",
    "*://*.google.com/*",
    "*://*.googleapis.com/*",
    "*://*.gstatic.com/*",
    "*://*.googleusercontent.com/*",
    "*://*.doubleclick.net/*",
    "https://sponsor.ajay.app/*",
    "https://returnyoutubedislikeapi.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "identity",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/tv*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/tv*"
      ],
      "js": [
        "config.js",
        "page.js",
        "services.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
